apiVersion: v1
kind: Secret
metadata:
  name: api-secret
  namespace: taskflow
  labels:
    app.kubernetes.io/part-of: taskflow
    app.kubernetes.io/managed-by: kubectl
    app.kubernetes.io/name: api

type: Opaque
stringData:
  DATABASE_URL: postgres://taskflow:change-me-local-only@postgres:5432/taskflow
  JWT_SECRET: replace-with-output-of-node-crypto-randomBytes-32-hex
