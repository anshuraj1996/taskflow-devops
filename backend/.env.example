# --- Runtime ---
NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# --- Database (matches docker-compose.yml defaults) ---
DATABASE_URL=postgresql://taskflow:taskflow@localhost:5432/taskflow?schema=public
# Used by the integration test suite only
TEST_DATABASE_URL=postgresql://taskflow:taskflow@localhost:5432/taskflow_test?schema=public

# --- Auth ---
# Must be at least 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars
JWT_EXPIRES_IN=1h
BCRYPT_SALT_ROUNDS=12

# --- HTTP ---
# Comma-separated list of allowed browser origins
CORS_ORIGIN=http://localhost:5173
# Number of reverse proxies in front of the API (for correct client IPs in rate limiting)
TRUST_PROXY=0
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=20

# --- Lifecycle ---
SHUTDOWN_TIMEOUT_MS=10000
DB_READY_TIMEOUT_MS=2000
