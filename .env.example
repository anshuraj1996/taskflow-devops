# Root-level variables used by docker-compose.yml. Copy to .env and adjust.
# Application variables for running on the host live in backend/.env.example
# and frontend/.env.example.

POSTGRES_USER=taskflow
POSTGRES_PASSWORD=taskflow
POSTGRES_DB=taskflow
POSTGRES_PORT=5432

# Required for the full stack (`docker compose up`). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars
JWT_EXPIRES_IN=1h

# Host ports for the full stack
API_PORT=4000
WEB_PORT=8080
